# =============================================================================
# GDG on Campus NTUST — LeetCode Contest Backend Config
# Copy to `.env` and fill in real values before running.
# =============================================================================

# ---- Admin authentication ---------------------------------------------------
# Single admin token. Anyone with this string can log into the dashboard.
# Generate: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- LeetCode session cookies ----------------------------------------------
# Comma-separated list of LEETCODE_SESSION cookie values, used for the
# runtime-percentile (beat-%) GraphQL lookup. One value works; multiple values
# enable round-robin rotation + automatic failover when a cookie is rate-limited.
#
# Empty / unset is allowed — beat-% bonus simply won't apply for AC submissions
# (base points still award normally).
#
# Get a cookie value: open leetcode.com in a browser logged in as you, then
# DevTools → Application → Cookies → LEETCODE_SESSION → Value.
LEETCODE_SESSIONS=

# ---- LeetCode API base ------------------------------------------------------
LEETCODE_API_BASE=https://leetcode-api-pied.vercel.app

# ---- Contest store ----------------------------------------------------------
# Where the live contest JSON state file is written. Created automatically.
DATA_DIR=./data

# ---- Polling tuning ---------------------------------------------------------
# Per-user polling interval (seconds). With ~60 users at 5s each, the global
# rate is ~12 req/s evenly spread.
POLL_INTERVAL_SEC=5
# How many recent submissions to fetch per user per poll.
POLL_RECENT_LIMIT=5
# Random jitter (0.0 - 1.0) applied to each user's interval to stagger requests.
POLL_JITTER=0.2
# Seconds to keep polling after `endTime` for late-arriving submissions
# whose submittedAt was inside the contest window.
POST_END_GRACE_SEC=90
# HTTP timeout for outbound LeetCode API calls.
LEETCODE_HTTP_TIMEOUT_SEC=10

# ---- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to hit the API. Use `*` only for local dev.
CORS_ORIGINS=https://leetcode.gdg-ntust.org,http://localhost:5173
